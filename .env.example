# Copy this file to .env in the same folder and fill it in. .env is in .gitignore,
# so the passwords never reach git.

# The sign-in for the viewer itself. It stays shut until both are set, and changing
# either signs everyone out.
VIEWER_USERNAME=
VIEWER_PASSWORD=

# A PostgreSQL server. Leave PGSQL_HOST empty to leave it off the list.
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USERNAME=postgres
PGSQL_PASSWORD=
# PostgreSQL always connects to one database, and the list of the others is read from it.
PGSQL_DATABASE=postgres

# A MySQL or MariaDB server. Leave MYSQL_HOST empty to leave it off the list.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
